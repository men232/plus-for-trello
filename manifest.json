{
  "update_url": "https://clients2.google.com/service/update2/crx",
  "name": "__MSG_extName__",
  "short_name": "Plus for Trello (Fixed)",
  "version": "6.5.11",
  "manifest_version": 3,
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "background": {
    "service_worker": "background-worker.js",
    "type": "module"
  },
  "homepage_url": "https://www.plusfortrello.com",
  "oauth2": {
    "client_id": "147493868263-rau69q6puvkskc83li1neonnbo0aelp9.apps.googleusercontent.com",
    "scopes": [
      "https://spreadsheets.google.com/feeds",
      "https://www.googleapis.com/auth/drive.file",
      "https://www.googleapis.com/auth/chromewebstore.readonly"
    ]
  },
  "action": {
    "default_icon": {
      "19": "images/icon19.png"
    },
    "default_title": "Plus for Trello",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "all_frames": true,
      "matches": [
        "https://trello.com/*"
      ],
      "js": [
        "libs/jquery.min.js",
        "libs/jquery-ui.custom.min.js",
        "libs/jquery.cookie.js",
        "libs/jquery.zoomooz.js",
        "libs/jsapi.js",
        "libs/formatchart.js",
        "libs/jquery.grumble.js",
        "libs/dialog-polyfill.js",
        "libs/jquery.tablesorter.js",
        "libs/select2.full.min.js",
        "shared.js",
        "sharedmobile.js",
        "sharedsync.js",
        "app.js",
        "card.js",
        "cardetransfer.js",
        "labels.js",
        "labels.js",
        "language.js",
        "help.js",
        "buttons.js",
        "plus.js",
        "plusconfig.js",
        "board.js",
        "tour.js",
        "translations.js"
      ],
      "css": [
        "css/style.css",
        "css/colors.css",
        "css/tooltip.css",
        "css/grumble.css",
        "css/dialog-polyfill.css",
        "css/tablesorter.css",
        "css/jquery-ui-custom.min.css",
        "css/select2.min.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "images/*.png",
        "images/*.gif",
        "*.html",
        "manifest.json",
        "css/images/*.gif",
        "stripe-wrap.js",
        "offscreen.js",
        "websql/**"
      ],
      "matches": [
        "https://trello.com/*"
      ]
    }
  ],
  "optional_permissions": [
    "clipboardWrite",
    "bookmarks"
  ],
  "permissions": [
    "identity",
    "storage",
    "offscreen",
    "cookies",
    "webRequest",
    "unlimitedStorage",
    "notifications",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://trello.com/",
    "https://trello.com/1/*"
  ]
}
